             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherVideoApp.Gui.Views.IssVideoFeedBackgroundView"
             x:DataType="vm:IssVideoFeedBackgroundViewModel">
             
