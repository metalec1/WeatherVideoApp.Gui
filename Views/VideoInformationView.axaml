<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WeatherVideoApp.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherVideoApp.Gui.Views.VideoInformationView"
             x:DataType="vm:VideoInformationViewModel">
    
    <ScrollViewer>
        <TextBlock Text="{Binding VideoInformationText}" 
                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
    </ScrollViewer>
    <UserControl.Background>
        <StaticResource ResourceKey="OverlayContentBrush"/>
    </UserControl.Background>
</UserControl>
