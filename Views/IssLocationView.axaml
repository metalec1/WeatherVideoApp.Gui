<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WeatherVideoApp.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherVideoApp.Gui.Views.IssLocationView"
             x:DataType="vm:IssLocationViewModel">
             
            <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*" ShowGridLines="True">
                <Viewbox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="Real time ISS location update" TextWrapping="Wrap"></TextBlock>
                </Viewbox>
                <Viewbox Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Latitude"></TextBlock>
                </Viewbox>
                <Viewbox Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="{Binding CurrentIssLocationState.Latitude}"></TextBlock>
                </Viewbox>
                
                <Viewbox Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Longitude"></TextBlock>
                </Viewbox>
                <Viewbox Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="{Binding CurrentIssLocationState.Longitude}"></TextBlock>
                </Viewbox>
            </Grid>
</UserControl>
