<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherVideoApp.Gui.Views.ProgramInformationView">
        
    <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" RowDefinitions="*,*,*,*,*,*,*">
        <StackPanel Grid.Column="3" Grid.Row="2" Grid.ColumnSpan="3" Grid.RowSpan="4" 
                    Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="WeatherVideoApp" FontWeight="Bold" FontSize="20"/>
            <TextBlock Text="Verzija: 1.0.0"/>
            <TextBlock Text="Avtor: Deni"/>
            <TextBlock Text="Licenca: Free"/>
        </StackPanel>
    </Grid>
    
    
    <UserControl.Background>
        <StaticResource ResourceKey="OverlayInfoBrush"/>
    </UserControl.Background>
</UserControl>
